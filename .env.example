DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Full public URL of this backend (used to build OAuth callback URL)
BACKEND_URL=https://your-backend.up.railway.app

# Full URL of the web portal (used as post-auth redirect destination)
FRONTEND_URL=https://your-web-portal.up.railway.app

# Comma-separated list of origins allowed to send credentialed requests
ALLOWED_ORIGINS=https://your-web-portal.up.railway.app,http://localhost:3000

FLASK_ENV=production
PORT=5000
